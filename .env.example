# ---------------------------------------------------------------------------
# JOBPILOT configuration
#
#   1. Copy this file to ".env"      (Windows: copy .env.example .env)
#   2. Fill in the values you actually have.
#   3. NEVER commit .env - it holds secrets.
#
# Every value has a safe default. Leave a line empty to disable that feature.
# ---------------------------------------------------------------------------

# --- Dice (the only supported platform) ------------------------------------
# Official Dice partner/enterprise job search API key.
# Ask Dice for partner/enterprise API access; without a key, use browser search
# (DICE_ALLOW_BROWSER_SEARCH below) or job search is simply unavailable.
DICE_API_KEY=

# Base URL and search path from your Dice partner documentation.
# The defaults below are the documented public partner-search shape.
DICE_API_BASE=https://api.dice.com
DICE_SEARCH_PATH=/services/partners/jobsearch/v1/simple.json

# How the key is sent: "header" (x-api-key) or "query" (api_key=...).
DICE_API_AUTH=header

# Some Dice partner agreements also require a client id header.
DICE_CLIENT_ID=

# Read the PUBLIC Dice site with a normal browser session (Playwright).
# This is a read-only search path, no bypassing of anything.
# Requires: pip install playwright && playwright install chromium
DICE_ALLOW_BROWSER_SEARCH=false

# How many results to keep per search, and how many job detail pages to open.
DICE_MAX_RESULTS=25
DICE_ENRICH_LIMIT=10

# --- AI (only two jobs: semantic matching + question understanding) ---------
# Any OpenAI-compatible endpoint works (OpenAI, Azure-compatible gateway, local server).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_ENABLED=true

# AI answers below this confidence are rejected and you are asked instead.
AI_MIN_CONFIDENCE=0.75

# --- Browser ---------------------------------------------------------------
# Keep this false: you can see what happens and sign in yourself when asked.
BROWSER_HEADLESS=false

# --- Network / politeness --------------------------------------------------
# Seconds between page requests. Do not lower this to scrape faster: this MVP
# deliberately stays slow and low-volume.
POLITE_DELAY_SECONDS=1.5
REQUEST_TIMEOUT=30
NAV_TIMEOUT=45

# Guard rail for future batch runs (menu 5 applies to one job at a time).
MAX_APPLICATIONS_PER_RUN=1
